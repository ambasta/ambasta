+#[cfg(test)]
+mod contains_generics_spec {
+    use super::ContainsGenericsExt as _;
+
+    #[test]
+    fn finds_type_parameters_in_function_pointer_and_fn_trait_arguments() {
+        let type_param = syn::Ident::new("T", proc_macro2::Span::call_site());
+        let params = &[&type_param];
+
+        for ty in [
+            syn::parse_quote! { fn(T) },
+            syn::parse_quote! { fn(u8) -> T },
+            syn::parse_quote! { dyn Fn(T) },
+        ] {
+            let ty: syn::Type = ty;
+            assert!(ty.contains_generics(params));
+        }
+
+        let unrelated: syn::Type = syn::parse_quote! { fn(u8) -> bool };
+        assert!(!unrelated.contains_generics(params));
     }
 }
 
