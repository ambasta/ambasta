+#[cfg(test)]
+mod add_extra_generic_type_param_spec {
+    use syn::{parse_quote, GenericParam, Generics};
+
+    use super::add_extra_generic_type_param;
+
+    #[test]
+    fn inserts_type_before_const_parameters() {
+        let generics: Generics = parse_quote! { <'a, T, const N: usize> };
+        let result = add_extra_generic_type_param(&generics, quote::quote! { U });
+        let params: Vec<_> = result.params.iter().collect();
+
+        assert!(matches!(params[0], GenericParam::Lifetime(_)));
+        assert!(matches!(params[1], GenericParam::Type(param) if param.ident == "T"));
+        assert!(matches!(params[2], GenericParam::Type(param) if param.ident == "U"));
+        assert!(matches!(params[3], GenericParam::Const(param) if param.ident == "N"));
+    }
 }
 
