+#[cfg(test)]
+mod tests {
+    use super::{search_hint, Hint};
+    use syn::parse_quote;
+
+    #[derive(Debug, PartialEq)]
+    enum TestHint {
+        Unit(String),
+        KeyValue(String, String),
+    }
+
+    impl Hint for TestHint {
+        fn unit(name: String) -> Option<Self> {
+            Some(Self::Unit(name))
+        }
+
+        fn key_value(key: String, value: String) -> Option<Self> {
+            Some(Self::KeyValue(key, value))
+        }
+    }
+
+    #[test]
+    fn finds_unit_hint() {
+        let attrs = [parse_quote!(#[node(full_range)])];
+        assert_eq!(
+            search_hint("node", &attrs),
+            Some(TestHint::Unit("full_range".into()))
+        );
+    }
+
+    #[test]
+    fn finds_string_key_value_hint() {
+        let attrs = [parse_quote!(#[visit(contains = "fields")])];
+        assert_eq!(
+            search_hint("visit", &attrs),
+            Some(TestHint::KeyValue("contains".into(), "fields".into()))
+        );
+    }
+
+    #[test]
+    fn ignores_unrelated_attribute() {
+        let attrs = [parse_quote!(#[derive(Clone)]), parse_quote!(#[visit(skip)])];
+        assert_eq!(
+            search_hint("visit", &attrs),
+            Some(TestHint::Unit("skip".into()))
+        );
+    }
+}
